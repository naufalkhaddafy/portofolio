---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  Navbar,
  Hero,
  About,
  Skills,
  Experience,
  Projects,
  Contact,
  Footer,
  ChatWidget,
  RocketButton,
  BackgroundCanvas,
  CustomCursor,
  GSAPAnimations,
} from '../components';
---

<BaseLayout title="Codepai Portfolio">
  <!-- Client-side components -->
  <CustomCursor client:load />
  <BackgroundCanvas client:load />
  <GSAPAnimations client:load />

  <!-- Wrap the content in an overflow-x-hidden container to prevent layout shifts during animations -->
  <div class="w-full overflow-x-hidden">
    <!-- Navbar -->
    <Navbar client:load />

    <!-- Main Content -->
    <main>
      <Hero client:load />
      <About client:load />
      <Skills client:load />
      <Experience client:load />
      <Projects client:load />
      <Contact client:load />
    </main>

    <!-- Footer -->
    <Footer />
  </div>

  <!-- Floating Elements -->
  <RocketButton client:load />
  <ChatWidget client:load />
</BaseLayout>
